# .env 로 복사해서 사용한다:  cp .env.example .env
# .env 는 .gitignore 에 포함되어 커밋되지 않는다. 아래 값은 전부 로컬용 가짜 값이다.
POSTGRES_USER=booking
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=booking

# Claude API (부킹 파싱). 콘솔에서 발급한 키를 .env 에만 넣는다.
ANTHROPIC_API_KEY=sk-ant-...
# 키가 특정 워크스페이스에 묶여 있지 않은(조직 범위) 키라면 워크스페이스 ID가 필요하다. 묶인 키면 비워둔다.
ANTHROPIC_WORKSPACE_ID=
# 선택: 모델과 타임아웃(ms). 장애 훈련 2번에서 CLAUDE_TIMEOUT_MS=1 로 낮춰 폴백을 재현한다.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_TIMEOUT_MS=10000

# Grafana 관리자 비밀번호 (로컬용 가짜 값)
GRAFANA_ADMIN_PASSWORD=change-me-local-only

# mock-forwarder 장애 주입 (기본 전부 정상). 훈련 1번: FWD_FAIL_RATE=0.5
FWD_FAIL_RATE=0
FWD_DELAY_MS=0
FWD_DUP_RATE=0
FWD_OUT_OF_ORDER=false
